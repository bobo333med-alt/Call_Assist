rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
 function isAuth() { return request.auth != null; }
 function isOwner(uid) { return isAuth() && request.auth.uid == uid; }
 function isAdmin() {
 return isAuth() && exists(/databases/$(database)/documents/agents/$(request.auth.uid))
 && get(/databases/$(database)/documents/agents/$(request.auth.uid)).data.role == 'admin';
 }
 match /agents/{uid} {
 allow read: if isAuth() && (isOwner(uid) || isAdmin());
 allow create: if isOwner(uid)
 && !request.resource.data.keys().hasAny(['role','pricePerMinute','active']);
 allow update: if isAdmin() ||
 (isOwner(uid) && !request.resource.data.diff(resource.data)
 .affectedKeys().hasAny(['role','pricePerMinute','active']));
 allow delete: if isAdmin();
 }
 match /settings/{doc} {
 allow read: if isAuth();
 allow write: if isAdmin();
 }
 match /calls/{callId} {
 allow read: if isAuth() && (resource.data.agentId == request.auth.uid || isAdmin());
 allow create: if isAuth() && request.resource.data.agentId == request.auth.uid;
 allow update, delete: if isAdmin();
 match /turns/{turnId} {
 allow read: if isAuth() && (
 get(/databases/$(database)/documents/calls/$(callId)).data.agentId == request.auth.uid
 || isAdmin());
 allow create: if isAuth() &&
 get(/databases/$(database)/documents/calls/$(callId)).data.agentId == request.auth.uid;
 allow update, delete: if false;
 }
 }
 }
}
